# Supabase is DISABLED until the schema has been reviewed. To enable later, set
# VITE_ENABLE_SUPABASE=true as well as the URL and anon key.
VITE_ENABLE_SUPABASE=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Production origin printed on share cards (https only; localhost is ignored).
# On Netlify this falls back to the site's main URL automatically.
VITE_SITE_URL=
